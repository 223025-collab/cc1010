    // 商品詳細モーダル用の一時状態
    let activeModalItem = null;
    let activeModalQty = 1;
    let activeModalOptions = [];

    // --- 初期化 ---
    window.onload = function () {
      renderCategoryTabs();
      renderMenuGrid();
      renderCart();
    };

    // --- カテゴリタブ描画 ---
    function renderCategoryTabs() {
      const container = document.getElementById('categoryTabs');
      container.innerHTML = CATEGORIES.map(cat => {
        const isActive = cat.id === currentCategory;
        return `
          <button onclick="selectCategory('${cat.id}')"
            class="px-4 py-2.5 rounded-2xl text-sm font-black whitespace-nowrap transition active:scale-95 flex items-center gap-1.5 border ${
              isActive
                ? 'bg-gradient-to-r from-amber-400 to-orange-500 text-slate-950 border-amber-300 shadow-lg shadow-amber-500/25'
                : 'bg-slate-800/70 text-slate-200 border-slate-700/70 hover:border-amber-400/40'
            }">
            <span>${cat.icon}</span>
            <span>${cat.name}</span>
          </button>
        `;
      }).join('');
    }

    function selectCategory(catId) {
      playTone(620, 0.06);
      currentCategory = catId;
      renderCategoryTabs();
      renderMenuGrid();
    }

    // --- メニューグリッド描画 ---
    function renderMenuGrid() {
      const catObj = CATEGORIES.find(c => c.id === currentCategory);
      document.getElementById('currentCategoryTitle').textContent = `${catObj.icon} ${catObj.name}`;

      const filtered = currentCategory === 'featured'
        ? MENU_ITEMS.filter(item => item.featured)
        : MENU_ITEMS.filter(item => item.category === currentCategory);

      document.getElementById('itemCountLabel').textContent = `${filtered.length}品`;

      const grid = document.getElementById('menuGrid');
      grid.innerHTML = filtered.map(item => `
        <article onclick="openItemModal('${item.id}')"
          class="holo-card card-shimmer rounded-3xl overflow-hidden cursor-pointer flex flex-col justify-between group">
          <!-- 商品ビジュアルエリア -->
          <div class="relative h-44 bg-gradient-to-br ${item.bgGradient} flex items-center justify-center overflow-hidden">
            <!-- やわらかなスポットライト演出 -->
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,rgba(255,255,255,0.14),transparent_68%)] pointer-events-none"></div>
            ${item.badge ? `
              <span class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-full text-[11px] font-black shadow-md ring-1 ring-white/25 ${item.badgeColor}">
                ${item.badge}
              </span>
            ` : ''}
            ${getDishVisualHtml(item, false)}
            ${!customImages[item.id] ? `
              <div class="absolute bottom-2.5 right-3 flex gap-1 text-base bg-slate-950/45 backdrop-blur-md px-2 py-0.5 rounded-full border border-white/10">
                ${item.subEmojis.map(e => `<span>${e}</span>`).join('')}
              </div>
            ` : ''}
          </div>

          <!-- 商品テキスト情報 -->
          <div class="p-4 flex-1 flex flex-col justify-between gap-3">
            <div>
              <h3 class="text-base font-black text-white leading-snug group-hover:text-amber-300 transition">
                ${item.name}
              </h3>
              <p class="text-xs text-slate-300/90 mt-1.5 line-clamp-2 leading-relaxed">
                ${item.desc}
              </p>
            </div>

            <div class="flex items-center justify-between pt-2.5 border-t border-white/10">
              <span class="text-lg font-black text-amber-300 tracking-tight">
                ¥${item.price.toLocaleString()}
                <span class="text-[10px] font-normal text-slate-400">税込</span>
              </span>
              <span class="px-3.5 py-1.5 rounded-xl bg-amber-400/15 border border-amber-400/45 text-amber-200 text-xs font-black group-hover:bg-gradient-to-r group-hover:from-amber-400 group-hover:to-orange-400 group-hover:text-slate-950 group-hover:border-transparent transition shadow-sm">
                えらぶ ＋
              </span>
            </div>
          </div>
        </article>
      `).join('');
    }

    // --- 商品詳細モーダル ---
    function openItemModal(itemId) {
      playTone(700, 0.07);
      const item = MENU_ITEMS.find(i => i.id === itemId);
      if (!item) return;

      activeModalItem = item;
      activeModalQty = 1;
      activeModalOptions = (item.options || []).map(opt => ({
        label: opt.label,
        name: opt.choices[0].name,
        priceDiff: opt.choices[0].priceDiff
      }));

      // ビジュアル設定
      const hero = document.getElementById('modalHero');
      hero.className = `relative h-48 sm:h-52 flex items-center justify-center bg-gradient-to-br ${item.bgGradient} overflow-hidden shrink-0`;

      document.getElementById('modalTag').innerHTML = item.badge
        ? `<span class="relative z-10 px-3 py-1 rounded-full text-xs font-black shadow ${item.badgeColor}">${item.badge}</span>`
        : '';

      const modalVisual = document.getElementById('modalVisual');
      if (customImages[item.id]) {
        modalVisual.className = 'w-full h-full';
        modalVisual.innerHTML = getDishVisualHtml(item, true);
      } else {
        modalVisual.className = 'flex items-center justify-center';
        modalVisual.innerHTML = getDishVisualHtml(item, true);
      }

      document.getElementById('modalTitle').textContent = item.name;
      document.getElementById('modalBasePrice').textContent = `¥${item.price.toLocaleString()}`;
      document.getElementById('modalDesc').textContent = item.desc;

      // アレルゲン表示
      const allergenBox = document.getElementById('modalAllergens');
      if (item.allergens && item.allergens.length > 0) {
        allergenBox.innerHTML = `<span class="text-[11px] text-slate-400 mr-1">アレルゲン:</span>` +
          item.allergens.map(a => `<span class="px-2 py-0.5 rounded-md bg-slate-800 border border-slate-700 text-[11px] text-slate-300">${a}</span>`).join('');
      } else {
        allergenBox.innerHTML = `<span class="text-[11px] text-slate-400">特定原材料（主要アレルゲン）なし</span>`;
      }

      renderModalOptions();
      updateModalTotals();

      const modal = document.getElementById('itemModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function renderModalOptions() {
      const container = document.getElementById('modalOptionsContainer');
      if (!activeModalItem.options || activeModalItem.options.length === 0) {
        container.innerHTML = '';
        return;
      }

      container.innerHTML = activeModalItem.options.map((opt, optIdx) => `
        <div>
          <div class="text-xs font-bold text-amber-300 mb-2">${opt.label}</div>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            ${opt.choices.map((choice, choiceIdx) => {
              const isSelected = activeModalOptions[optIdx].name === choice.name;
              const diffText = choice.priceDiff > 0
                ? `+¥${choice.priceDiff}`
                : (choice.priceDiff < 0 ? `-¥${Math.abs(choice.priceDiff)}` : '');
              return `
                <button type="button" onclick="selectModalOption(${optIdx}, ${choiceIdx})"
                  class="px-3 py-2.5 rounded-xl text-xs font-bold border transition text-center active:scale-95 ${
                    isSelected
                      ? 'bg-amber-400/20 border-amber-400 text-amber-200'
                      : 'bg-slate-800/70 border-slate-700 text-slate-300 hover:border-slate-500'
                  }">
                  <div>${choice.name}</div>
                  ${diffText ? `<div class="text-[10px] opacity-80 mt-0.5">${diffText}</div>` : ''}
                </button>
              `;
            }).join('')}
          </div>
        </div>
      `).join('');
    }

    function selectModalOption(optIdx, choiceIdx) {
      playTone(680, 0.05);
      const opt = activeModalItem.options[optIdx];
      const choice = opt.choices[choiceIdx];
      activeModalOptions[optIdx] = {
        label: opt.label,
        name: choice.name,
        priceDiff: choice.priceDiff
      };
      renderModalOptions();
      updateModalTotals();
    }

    function changeModalQty(delta) {
      playTone(delta > 0 ? 740 : 540, 0.05);
      activeModalQty = Math.max(1, Math.min(20, activeModalQty + delta));
      updateModalTotals();
    }

    function updateModalTotals() {
      document.getElementById('modalQty').textContent = activeModalQty;
      const optExtra = activeModalOptions.reduce((sum, o) => sum + o.priceDiff, 0);
      const unitPrice = activeModalItem.price + optExtra;
      const total = unitPrice * activeModalQty;
      document.getElementById('modalTotalBtnPrice').textContent = `¥${total.toLocaleString()}`;
    }

    function closeItemModal() {
      const modal = document.getElementById('itemModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // --- カート追加・操作 ---
    function addModalItemToCart() {
      playSuccessChime();
      const optExtra = activeModalOptions.reduce((sum, o) => sum + o.priceDiff, 0);
      const unitPrice = activeModalItem.price + optExtra;
      const optKey = activeModalOptions.map(o => o.name).join('|');
      const cartId = `${activeModalItem.id}__${optKey}`;

      const existing = cart.find(c => c.cartId === cartId);
      if (existing) {
        existing.qty += activeModalQty;
      } else {
        cart.push({
          cartId,
          item: activeModalItem,
          selectedOptions: JSON.parse(JSON.stringify(activeModalOptions)),
          qty: activeModalQty,
          unitPrice
        });
      }

      closeItemModal();
      renderCart();
      showToast(`「${activeModalItem.name}」を追加しました！`);
    }

    function updateCartQty(cartId, delta) {
      playTone(delta > 0 ? 720 : 520, 0.05);
      const target = cart.find(c => c.cartId === cartId);
      if (!target) return;
      target.qty += delta;
      if (target.qty <= 0) {
        cart = cart.filter(c => c.cartId !== cartId);
      }
      renderCart();
    }

    function clearCart() {
      playTone(440, 0.08);
      cart = [];
      renderCart();
    }

    // --- カートUI描画（デスクトップ & モバイル同期） ---
    function renderCart() {
      const totalCount = cart.reduce((sum, c) => sum + c.qty, 0);
      const totalPrice = cart.reduce((sum, c) => sum + (c.unitPrice * c.qty), 0);
      const totalEnergy = Math.min(100, cart.reduce((sum, c) => sum + (c.item.energy * c.qty), 0));

      // デスクトップ用メーター更新
      document.getElementById('desktopMantanPercent').textContent = `${totalEnergy}%`;
      document.getElementById('desktopMantanBar').style.width = `${totalEnergy}%`;
      const msgEl = document.getElementById('desktopMantanMsg');
      if (totalEnergy === 0) {
        msgEl.textContent = 'お好きな料理をタップして選んでね！';
      } else if (totalEnergy < 60) {
        msgEl.textContent = 'いい感じ！ドリンクやデザートもいかが？';
      } else if (totalEnergy < 100) {
        msgEl.textContent = 'もうすぐエネルギーまんたん！';
      } else {
        msgEl.textContent = '⚡ エネルギー100%まんたん！ごゆっくりどうぞ♪';
      }

      // 合計・件数更新
      document.getElementById('desktopCartCount').textContent = `${totalCount}点`;
      document.getElementById('desktopCartTotal').textContent = `¥${totalPrice.toLocaleString()}`;
      document.getElementById('mobileCartBadge').textContent = totalCount;
      document.getElementById('mobileCartTotal').textContent = `¥${totalPrice.toLocaleString()}`;
      document.getElementById('mobileModalTotal').textContent = `¥${totalPrice.toLocaleString()}`;

      // ボタン活性制御
      const isEmpty = cart.length === 0;
      document.getElementById('desktopOrderBtn').disabled = isEmpty;
      document.getElementById('mobileOrderBtn').disabled = isEmpty;
      document.getElementById('desktopClearBtn').classList.toggle('hidden', isEmpty);
      document.getElementById('mobileClearBtn').classList.toggle('hidden', isEmpty);

      // カート一覧HTML生成
      const listHtml = isEmpty
        ? `
          <div class="py-10 text-center text-slate-400 space-y-2">
            <div class="text-4xl opacity-60">🍽️</div>
            <p class="text-sm font-bold">まだ商品が選ばれていません</p>
            <p class="text-xs opacity-75">左のメニューからタップして追加できます</p>
          </div>
        `
        : cart.map(c => {
            const optSummary = c.selectedOptions.map(o => o.name).join(' / ');
            return `
              <div class="p-3 rounded-2xl bg-slate-800/75 border border-slate-700/70 flex items-center justify-between gap-2">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    <span>${c.item.emoji}</span>
                    <span class="text-sm font-bold text-white truncate">${c.item.name}</span>
                  </div>
                  ${optSummary ? `<div class="text-[11px] text-slate-400 truncate mt-0.5">${optSummary}</div>` : ''}
                  <div class="text-xs font-black text-amber-300 mt-1">¥${(c.unitPrice * c.qty).toLocaleString()}</div>
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  <button onclick="updateCartQty('${c.cartId}', -1)"
                    class="w-8 h-8 rounded-lg bg-slate-900 hover:bg-slate-700 text-white font-black text-sm transition active:scale-90">−</button>
                  <span class="w-6 text-center text-sm font-black text-white">${c.qty}</span>
                  <button onclick="updateCartQty('${c.cartId}', 1)"
                    class="w-8 h-8 rounded-lg bg-slate-900 hover:bg-slate-700 text-white font-black text-sm transition active:scale-90">＋</button>
                </div>
              </div>
            `;
          }).join('');

      document.getElementById('desktopCartItems').innerHTML = listHtml;
      document.getElementById('mobileCartItems').innerHTML = listHtml;
    }

    // --- 注文確定処理 ---
    function submitOrder() {
      if (cart.length === 0) return;
      playSuccessChime();

      const now = new Date();
      const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      const orderTotal = cart.reduce((sum, c) => sum + (c.unitPrice * c.qty), 0);

      orderHistory.unshift({
        time: timeStr,
        items: JSON.parse(JSON.stringify(cart)),
        total: orderTotal
      });

      // 履歴バッジ更新
      const totalOrderedCount = orderHistory.reduce(
        (sum, ord) => sum + ord.items.reduce((s, i) => s + i.qty, 0), 0
      );
      const badge = document.getElementById('historyBadge');
      badge.textContent = totalOrderedCount;
      badge.classList.remove('hidden');

      // カートを空にしてモーダルを閉じる
      cart = [];
      renderCart();
      closeMobileCartModal();

      // 完了メッセージ表示
      showFeedback(
        '🍳',
        'ご注文ありがとうございます！',
        'キッチンにオーダーが届きました。おばあちゃんとスタッフが心を込めてお作りしますので、海を眺めながらソファでゆっくりお待ちください♪'
      );
    }

    // --- モバイルカートモーダル ---
    function openMobileCartModal() {
      playTone(660, 0.06);
      const modal = document.getElementById('mobileCartModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
    function closeMobileCartModal() {
      const modal = document.getElementById('mobileCartModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // --- 店員さん呼び出し ---
    function openStaffModal() {
      playTone(680, 0.06);
      const modal = document.getElementById('staffModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
    function closeStaffModal() {
      const modal = document.getElementById('staffModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
    function callStaff(reason) {
      playSuccessChime();
      closeStaffModal();
      showFeedback(
        '🔔',
        'スタッフをお呼びしました',
        `「${reason}」で承りました。ただいま海側ソファ席 #04 へお伺いします！`
      );
    }

    // --- 注文履歴モーダル ---
    function openHistoryModal() {
      playTone(660, 0.06);
      const listEl = document.getElementById('historyList');
      const grandTotal = orderHistory.reduce((sum, o) => sum + o.total, 0);
      document.getElementById('historyGrandTotal').textContent = `¥${grandTotal.toLocaleString()}`;

      if (orderHistory.length === 0) {
        listEl.innerHTML = `
          <div class="py-10 text-center text-slate-400 space-y-2">
            <div class="text-4xl opacity-60">🧾</div>
            <p class="text-sm font-bold">まだ注文履歴がありません</p>
          </div>
        `;
      } else {
        listEl.innerHTML = orderHistory.map(ord => `
          <div class="p-3.5 rounded-2xl bg-slate-800/75 border border-slate-700/70 space-y-2">
            <div class="flex items-center justify-between text-xs text-sky-300 font-bold border-b border-slate-700/60 pb-1.5">
              <span>🕒 ${ord.time} のご注文</span>
              <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300">調理中 / 提供済</span>
            </div>
            ${ord.items.map(i => `
              <div class="flex items-center justify-between text-sm">
                <span class="text-slate-200">${i.item.emoji} ${i.item.name} × ${i.qty}</span>
                <span class="font-bold text-amber-300">¥${(i.unitPrice * i.qty).toLocaleString()}</span>
              </div>
            `).join('')}
          </div>
        `).join('');
      }

      const modal = document.getElementById('historyModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
    function closeHistoryModal() {
      const modal = document.getElementById('historyModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // --- フィードバックモーダル & トースト ---
    function showFeedback(icon, title, message) {
      document.getElementById('feedbackIcon').textContent = icon;
      document.getElementById('feedbackTitle').textContent = title;
      document.getElementById('feedbackMessage').textContent = message;
      const modal = document.getElementById('feedbackModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
    function closeFeedbackModal() {
      playTone(600, 0.05);
      const modal = document.getElementById('feedbackModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    let toastTimer = null;
    function showToast(text) {
      const toast = document.getElementById('toast');
      document.getElementById('toastText').textContent = text;
      toast.classList.remove('opacity-0', '-translate-y-2');
      toast.classList.add('opacity-100', 'translate-y-0');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add('opacity-0', '-translate-y-2');
        toast.classList.remove('opacity-100', 'translate-y-0');
      }, 2000);
    }

    // --- 写真設定モーダル（ローカルの料理写真を読み込み） ---
    function openPhotoModal() {
      playTone(680, 0.06);
      renderPhotoSettingList();
      const modal = document.getElementById('photoModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closePhotoModal() {
      playTone(600, 0.05);
      const modal = document.getElementById('photoModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function renderPhotoSettingList() {
      const container = document.getElementById('photoSettingList');
      container.innerHTML = MENU_ITEMS.map(item => {
        const hasPhoto = Boolean(customImages[item.id]);
        return `
          <div class="p-3 rounded-2xl bg-slate-800/75 border border-slate-700/70 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-14 h-14 rounded-xl overflow-hidden bg-slate-900 border border-slate-700 flex items-center justify-center shrink-0">
                ${hasPhoto
                  ? `<img src="${customImages[item.id]}" alt="${item.name}" class="w-full h-full object-cover" />`
                  : `<span class="text-2xl">${item.emoji}</span>`
                }
              </div>
              <div class="min-w-0">
                <div class="text-sm font-bold text-white truncate">${item.name}</div>
                <div class="text-[11px] ${hasPhoto ? 'text-emerald-300' : 'text-slate-400'}">
                  ${hasPhoto ? '✅ 写真が設定されています' : 'イラスト表示中'}
                </div>
              </div>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <label class="cursor-pointer px-3 py-2 rounded-xl bg-amber-400/20 hover:bg-amber-400/30 border border-amber-400/50 text-amber-200 text-xs font-black transition active:scale-95">
                写真を選ぶ
                <input type="file" accept="image/*" class="hidden" onchange="handlePhotoUpload(event, '${item.id}')" />
              </label>
              ${hasPhoto ? `
                <button onclick="removeCustomPhoto('${item.id}')" title="イラストに戻す"
                  class="px-2.5 py-2 rounded-xl bg-slate-700 hover:bg-rose-500/30 text-slate-300 hover:text-rose-200 text-xs font-bold transition">
                  戻す
                </button>
              ` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    function handlePhotoUpload(event, itemId) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      try {
        if (customImages[itemId]) {
          URL.revokeObjectURL(customImages[itemId]);
        }
        customImages[itemId] = URL.createObjectURL(file);
        playSuccessChime();
        renderPhotoSettingList();
        renderMenuGrid();
        showToast('写真をメニューに反映しました！');
      } catch (e) {
        showToast('写真の読み込みに失敗しました');
      }
    }

    function removeCustomPhoto(itemId) {
      playTone(500, 0.06);
      if (customImages[itemId]) {
        URL.revokeObjectURL(customImages[itemId]);
        delete customImages[itemId];
      }
      renderPhotoSettingList();
      renderMenuGrid();
    }
  </script>
</body>
</html>
