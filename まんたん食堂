<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>まんたんテラス | タッチパネルメニュー</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Zen Maru Gothic & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Zen+Maru+Gothic:wght@500;700;900&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Zen Maru Gothic"', '"Inter"', 'sans-serif'],
          },
          colors: {
            terrace: {
              dark: '#0f172a',
              panel: 'rgba(20, 30, 48, 0.72)',
              amber: '#f59e0b',
              glow: '#fbbf24',
              sunset: '#fb7185',
              ocean: '#38bdf8',
            }
          }
        }
      }
    }
  </script>

  <style>
    /* ホログラム・タッチパネル風の背景とガラス質感（夕暮れの海辺×光の粒子） */
    body {
      background:
        radial-gradient(ellipse 80% 50% at 85% 10%, rgba(251, 146, 60, 0.28) 0%, transparent 55%),
        radial-gradient(ellipse 70% 55% at 12% 88%, rgba(56, 189, 248, 0.24) 0%, transparent 55%),
        radial-gradient(circle at 50% 45%, rgba(251, 191, 36, 0.08) 0%, transparent 60%),
        linear-gradient(145deg, #070d1f 0%, #131d36 48%, #21172a 100%);
      background-attachment: fixed;
      color: #f8fafc;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    /* 背景の繊細なホログラムグリッド＆光のオーブ */
    .bg-ambient-grid {
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: radial-gradient(ellipse 85% 75% at 50% 35%, black 35%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 85% 75% at 50% 35%, black 35%, transparent 100%);
    }

    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) scale(1); opacity: 0.45; }
      50% { transform: translateY(-14px) scale(1.06); opacity: 0.7; }
    }
    .ambient-orb {
      animation: floatSlow 9s ease-in-out infinite;
    }

    /* 宙に浮かぶ高精細ガラスパネル効果 */
    .holo-panel {
      background: linear-gradient(160deg, rgba(22, 33, 56, 0.72) 0%, rgba(12, 19, 36, 0.78) 100%);
      backdrop-filter: blur(22px) saturate(135%);
      -webkit-backdrop-filter: blur(22px) saturate(135%);
      border: 1px solid rgba(251, 191, 36, 0.26);
      box-shadow:
        0 16px 40px -8px rgba(0, 0, 0, 0.48),
        inset 0 1px 0 rgba(255, 255, 255, 0.16),
        inset 0 0 24px rgba(251, 191, 36, 0.04),
        0 0 28px rgba(251, 191, 36, 0.07);
    }

    .holo-card {
      position: relative;
      background: linear-gradient(165deg, rgba(30, 41, 59, 0.62) 0%, rgba(15, 23, 42, 0.74) 100%);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.11);
      box-shadow:
        0 8px 24px -6px rgba(0, 0, 0, 0.35),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
      transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
                  border-color 0.25s ease,
                  box-shadow 0.28s ease;
    }

    .holo-card:hover {
      transform: translateY(-4px);
      border-color: rgba(251, 191, 36, 0.55);
      box-shadow:
        0 18px 34px -10px rgba(0, 0, 0, 0.5),
        0 0 24px rgba(251, 191, 36, 0.18),
        inset 0 1px 0 rgba(255, 255, 255, 0.22);
    }

    .holo-card:active {
      transform: translateY(-1px) scale(0.985);
    }

    /* カードホバー時のきらめき（シマー） */
    .card-shimmer::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.12) 50%, transparent 65%);
      transform: translateX(-120%);
      transition: transform 0.75s ease;
      pointer-events: none;
    }
    .card-shimmer:hover::after {
      transform: translateX(120%);
    }

    /* ネオンサイン風テキスト（温かみのある上品な光彩） */
    .neon-text {
      text-shadow:
        0 0 12px rgba(251, 191, 36, 0.55),
        0 0 28px rgba(245, 158, 11, 0.3);
    }

    /* 料理のほわほわ湯気アニメーション */
    @keyframes steamRise {
      0% { transform: translateY(4px) scaleX(1); opacity: 0; }
      40% { opacity: 0.55; }
      100% { transform: translateY(-12px) scaleX(1.15); opacity: 0; }
    }
    .steam-line {
      animation: steamRise 3.2s ease-in-out infinite;
    }
    .steam-line-delay {
      animation: steamRise 3.2s ease-in-out 1.4s infinite;
    }

    /* エネルギーバーの光の流れ */
    @keyframes barShimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    .energy-bar-glow {
      background: linear-gradient(90deg, #38bdf8, #fbbf24, #fb923c, #fbbf24, #38bdf8);
      background-size: 200% 100%;
      animation: barShimmer 4s linear infinite;
      box-shadow: 0 0 12px rgba(251, 191, 36, 0.5);
    }

    /* スクロールバーのカスタマイズ */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.3);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(251, 191, 36, 0.35);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(251, 191, 36, 0.6);
    }

    /* アニメーション */
    @keyframes popIn {
      0% { opacity: 0; transform: scale(0.94) translateY(8px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }
    .animate-pop {
      animation: popIn 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* スクロールバー非表示用（カテゴリタブ） */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col overflow-x-hidden relative">

  <!-- 背景のホログラム装飾（クリックを透過） -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <div class="absolute inset-0 bg-ambient-grid opacity-70"></div>
    <div class="ambient-orb absolute -top-24 -right-24 w-96 h-96 rounded-full bg-amber-500/15 blur-3xl"></div>
    <div class="ambient-orb absolute -bottom-28 -left-24 w-96 h-96 rounded-full bg-sky-400/15 blur-3xl" style="animation-delay: -4s;"></div>
  </div>

  <!-- ==================== ヘッダー ==================== -->
  <header class="sticky top-0 z-30 holo-panel border-x-0 border-t-0 px-3 sm:px-6 py-3">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2 sm:gap-4">
      <!-- 店名ロゴと座席表示 -->
      <div class="flex items-center gap-3">
        <!-- バッテリーまんたんアイコン -->
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center shadow-lg shadow-amber-500/30 shrink-0">
          <svg class="w-6 h-6 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="16" height="10" rx="2.5"></rect>
            <line x1="22" y1="11" x2="22" y2="13"></line>
            <path d="M6 10v4M10 10v4M14 10v4" stroke-width="2.4"></path>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-lg sm:text-2xl font-black tracking-wider text-amber-300 neon-text leading-none">
              まんたんテラス
            </h1>
            <span class="hidden sm:inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-500/20 text-sky-300 border border-sky-400/30">
              海側ソファ席 #04
            </span>
          </div>
          <p class="text-[11px] sm:text-xs text-slate-300 mt-0.5">
            おばあちゃんの味 × 潮風のダイニング
          </p>
        </div>
      </div>

      <!-- ヘッダー右側のクイック操作ボタン -->
      <div class="flex items-center gap-2">
        <!-- 写真設定モーダルを開くボタン -->
        <button onclick="openPhotoModal()" title="メニューに手元の写真を設定"
          class="flex items-center gap-1.5 px-2.5 py-2 sm:px-3.5 sm:py-2.5 rounded-xl bg-slate-800/75 hover:bg-slate-700/80 border border-amber-400/40 text-xs sm:text-sm font-bold text-amber-200 transition active:scale-95">
          <span>📷</span>
          <span class="hidden md:inline">写真設定</span>
        </button>

        <!-- サウンド切替 -->
        <button id="soundToggleBtn" onclick="toggleSound()" title="操作音のON/OFF"
          class="p-2.5 rounded-xl bg-slate-800/70 hover:bg-slate-700/80 border border-slate-600/50 text-amber-300 transition active:scale-95"
          aria-label="操作音の切り替え">
          <span id="soundIcon">🔊</span>
        </button>

        <!-- 注文履歴ボタン -->
        <button onclick="openHistoryModal()"
          class="flex items-center gap-1.5 px-3 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-slate-800/75 hover:bg-slate-700/80 border border-slate-600/50 text-xs sm:text-sm font-bold text-slate-100 transition active:scale-95">
          <span>🧾</span>
          <span class="hidden sm:inline">注文履歴</span>
          <span id="historyBadge" class="hidden px-1.5 py-0.5 text-[10px] rounded-full bg-sky-500 text-white">0</span>
        </button>

        <!-- 店員さん呼び出しボタン -->
        <button onclick="openStaffModal()"
          class="flex items-center gap-1.5 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-gradient-to-r from-amber-400 via-amber-500 to-orange-500 hover:from-amber-300 hover:to-orange-400 text-slate-950 text-xs sm:text-sm font-black shadow-lg shadow-amber-500/30 ring-1 ring-amber-200/40 transition active:scale-95">
          <span>🔔</span>
          <span>店員さんを呼ぶ</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== メインコンテンツ ==================== -->
  <div class="relative z-10 flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 py-4 sm:py-6 flex flex-col lg:flex-row gap-6 pb-28 lg:pb-8">

    <!-- 左側：カテゴリタブ & メニュー一覧 -->
    <main class="flex-1 min-w-0 flex flex-col gap-5">

      <!-- お知らせバナー -->
      <div class="holo-panel rounded-2xl px-4 py-3.5 flex items-center justify-between gap-3 border-amber-400/30 bg-gradient-to-r from-amber-500/10 via-slate-900/60 to-sky-500/10">
        <div class="flex items-center gap-3 text-xs sm:text-sm text-amber-50/95">
          <span class="w-9 h-9 rounded-xl bg-amber-400/15 border border-amber-300/30 flex items-center justify-center text-lg shrink-0 shadow-inner">🌅</span>
          <span class="leading-relaxed">
            <strong class="text-amber-300 font-black">夕暮れタイムサービス！</strong>
            おこさまメニューご注文で、お隣の遊園地キッズメダルを1枚プレゼント中♪
          </span>
        </div>
        <span class="hidden md:inline-flex items-center gap-1 text-xs font-bold px-3 py-1 rounded-full bg-amber-400/15 text-amber-200 border border-amber-300/35 shrink-0">
          <span>🛋️</span> 全席ソファ席
        </span>
      </div>

      <!-- カテゴリタブ（横スクロール対応） -->
      <nav aria-label="メニューカテゴリ" class="flex gap-2 overflow-x-auto no-scrollbar pb-1">
        <div id="categoryTabs" class="flex gap-2">
          <!-- JSで動的生成 -->
        </div>
      </nav>

      <!-- メニューグリッド -->
      <section aria-label="商品一覧">
        <div class="flex items-center justify-between mb-3">
          <h2 id="currentCategoryTitle" class="text-lg sm:text-xl font-black text-white flex items-center gap-2">
            ✨ おすすめメニュー
          </h2>
          <span id="itemCountLabel" class="text-xs text-slate-400 font-semibold"></span>
        </div>
        <div id="menuGrid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
          <!-- JSで動的生成 -->
        </div>
      </section>
    </main>

    <!-- 右側：デスクトップ用 注文カートパネル -->
    <aside class="hidden lg:flex lg:w-96 shrink-0 flex-col">
      <div class="holo-panel rounded-3xl p-5 sticky top-24 flex flex-col max-h-[calc(100vh-7.5rem)]">
        <div class="flex items-center justify-between pb-3 border-b border-slate-700/70">
          <h2 class="text-lg font-black text-amber-300 flex items-center gap-2">
            <span>🛒</span> ご注文リスト
          </h2>
          <button onclick="clearCart()" id="desktopClearBtn"
            class="text-xs text-slate-400 hover:text-rose-400 transition hidden">
            すべてクリア
          </button>
        </div>

        <!-- おなかまんたんメーター -->
        <div class="mt-3 p-3.5 rounded-2xl bg-slate-900/65 border border-amber-400/20 shadow-inner">
          <div class="flex items-center justify-between text-xs mb-2">
            <span class="font-bold text-slate-200 flex items-center gap-1">⚡ エネルギーまんたん度</span>
            <span id="desktopMantanPercent" class="font-black text-amber-300 text-sm">0%</span>
          </div>
          <div class="w-full h-3 bg-slate-950/80 rounded-full overflow-hidden p-0.5 border border-white/5">
            <div id="desktopMantanBar" class="h-full energy-bar-glow rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
          <p id="desktopMantanMsg" class="text-[11px] text-slate-300 mt-2">
            お好きな料理をタップして選んでね！
          </p>
        </div>

        <!-- カート内アイテムリスト -->
        <div id="desktopCartItems" class="flex-1 overflow-y-auto my-3 space-y-2.5 pr-1">
          <!-- JSで動的生成 -->
        </div>

        <!-- 合計金額と注文確定ボタン -->
        <div class="pt-3 border-t border-slate-700/70 space-y-3">
          <div class="flex items-end justify-between">
            <div>
              <span class="text-xs text-slate-400 block">合計（税込）</span>
              <span id="desktopCartCount" class="text-xs font-bold text-sky-300">0点</span>
            </div>
            <span id="desktopCartTotal" class="text-2xl font-black text-white">¥0</span>
          </div>
          <button id="desktopOrderBtn" onclick="submitOrder()" disabled
            class="w-full py-3.5 rounded-2xl font-black text-base transition active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed bg-gradient-to-r from-amber-400 to-orange-500 hover:from-amber-300 hover:to-orange-400 text-slate-950 shadow-lg shadow-amber-500/25">
            この内容で注文する
          </button>
        </div>
      </div>
    </aside>
  </div>

  <!-- ==================== モバイル用 固定フッターカートバー ==================== -->
  <div class="lg:hidden fixed bottom-0 left-0 right-0 z-30 p-3 bg-gradient-to-t from-slate-950 via-slate-950/90 to-transparent">
    <button onclick="openMobileCartModal()"
      class="w-full max-w-xl mx-auto holo-panel rounded-2xl px-4 py-3 flex items-center justify-between border-amber-400/50 shadow-xl active:scale-[0.98] transition">
      <div class="flex items-center gap-3">
        <div class="relative w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-xl">
          🛒
          <span id="mobileCartBadge" class="absolute -top-1.5 -right-1.5 min-w-[20px] h-5 px-1 rounded-full bg-amber-400 text-slate-950 text-xs font-black flex items-center justify-center">
            0
          </span>
        </div>
        <div class="text-left">
          <div class="text-xs text-slate-300 font-bold">ご注文リストを確認</div>
          <div id="mobileCartTotal" class="text-lg font-black text-white leading-tight">¥0</div>
        </div>
      </div>
      <span class="px-4 py-2 rounded-xl bg-gradient-to-r from-amber-400 to-orange-500 text-slate-950 text-sm font-black">
        注文へ進む →
      </span>
    </button>
  </div>

  <!-- ==================== 商品詳細・カスタマイズモーダル ==================== -->
  <div id="itemModal" class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-4 bg-slate-950/75 backdrop-blur-sm">
    <div class="holo-panel rounded-3xl w-full max-w-lg max-h-[90vh] flex flex-col overflow-hidden animate-pop border-amber-400/40">
      <!-- モーダル上部イラストエリア -->
      <div id="modalHero" class="relative h-44 sm:h-48 flex items-center justify-center bg-gradient-to-br from-slate-800 to-slate-900 overflow-hidden shrink-0">
        <!-- 閉じるボタン -->
        <button onclick="closeItemModal()"
          class="absolute top-3 right-3 w-10 h-10 rounded-full bg-slate-950/60 hover:bg-slate-900 text-white flex items-center justify-center text-lg font-bold border border-white/15 transition active:scale-95"
          aria-label="閉じる">✕</button>
        <div id="modalTag" class="absolute top-3 left-3"></div>
        <div id="modalVisual" class="transform scale-125"></div>
      </div>

      <!-- モーダル本文 -->
      <div class="p-5 overflow-y-auto space-y-4">
        <div>
          <div class="flex items-start justify-between gap-2">
            <h3 id="modalTitle" class="text-xl font-black text-white"></h3>
            <span id="modalBasePrice" class="text-xl font-black text-amber-300 shrink-0"></span>
          </div>
          <p id="modalDesc" class="text-sm text-slate-300 mt-1.5 leading-relaxed"></p>
          <div id="modalAllergens" class="flex flex-wrap gap-1.5 mt-2.5"></div>
        </div>

        <!-- カスタマイズオプション領域 -->
        <div id="modalOptionsContainer" class="space-y-3 pt-2 border-t border-slate-700/70"></div>

        <!-- 数量セレクター -->
        <div class="flex items-center justify-between pt-3 border-t border-slate-700/70">
          <span class="text-sm font-bold text-slate-200">数量</span>
          <div class="flex items-center gap-3">
            <button onclick="changeModalQty(-1)"
              class="w-10 h-10 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-lg font-black text-white transition active:scale-95">−</button>
            <span id="modalQty" class="w-8 text-center text-lg font-black text-amber-300">1</span>
            <button onclick="changeModalQty(1)"
              class="w-10 h-10 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-lg font-black text-white transition active:scale-95">＋</button>
          </div>
        </div>
      </div>

      <!-- モーダルフッター -->
      <div class="p-4 bg-slate-900/80 border-t border-slate-700/70 flex items-center gap-3">
        <button onclick="closeItemModal()"
          class="px-4 py-3 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-bold transition">
          もどる
        </button>
        <button onclick="addModalItemToCart()"
          class="flex-1 py-3 rounded-2xl bg-gradient-to-r from-amber-400 to-orange-500 hover:from-amber-300 hover:to-orange-400 text-slate-950 font-black text-base shadow-lg shadow-amber-500/25 transition active:scale-95 flex items-center justify-center gap-2">
          <span>リストに追加</span>
          <span id="modalTotalBtnPrice" class="px-2 py-0.5 rounded-lg bg-slate-950/15 text-sm"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- ==================== モバイル用カートモーダル ==================== -->
  <div id="mobileCartModal" class="fixed inset-0 z-50 hidden items-end sm:items-center justify-center bg-slate-950/75 backdrop-blur-sm p-0 sm:p-4">
    <div class="holo-panel rounded-t-3xl sm:rounded-3xl w-full max-w-lg max-h-[85vh] flex flex-col overflow-hidden animate-pop border-amber-400/40">
      <div class="px-5 py-4 border-b border-slate-700/70 flex items-center justify-between">
        <h3 class="text-lg font-black text-amber-300 flex items-center gap-2">🛒 ご注文リスト</h3>
        <div class="flex items-center gap-3">
          <button onclick="clearCart()" id="mobileClearBtn" class="text-xs text-slate-400 hover:text-rose-400 hidden">クリア</button>
          <button onclick="closeMobileCartModal()" class="w-9 h-9 rounded-full bg-slate-800 text-white font-bold">✕</button>
        </div>
      </div>
      <div id="mobileCartItems" class="flex-1 overflow-y-auto p-4 space-y-2.5"></div>
      <div class="p-4 bg-slate-900/85 border-t border-slate-700/70 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-sm font-bold text-slate-300">合計金額（税込）</span>
          <span id="mobileModalTotal" class="text-2xl font-black text-white">¥0</span>
        </div>
        <button id="mobileOrderBtn" onclick="submitOrder()" disabled
          class="w-full py-3.5 rounded-2xl bg-gradient-to-r from-amber-400 to-orange-500 text-slate-950 font-black text-base disabled:opacity-40 transition active:scale-95">
          この内容で注文する
        </button>
      </div>
    </div>
  </div>

  <!-- ==================== 店員さん呼び出しモーダル ==================== -->
  <div id="staffModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm">
    <div class="holo-panel rounded-3xl w-full max-w-md p-5 space-y-4 animate-pop border-amber-400/40">
